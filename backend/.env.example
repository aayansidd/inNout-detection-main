# Copy to .env — never commit .env
AEGIS_MAX_SCAN_FILE_SIZE_MB=50
AEGIS_SCAN_WORKERS=4
AEGIS_DATA_DIR=./data
AEGIS_RETENTION_DAYS=30
AEGIS_REDACT_FILENAMES=false
AEGIS_DEMO_MODE=true
AEGIS_VAULT_PASSPHRASE=change-me
AEGIS_HMAC_SECRET=change-me-too
AEGIS_LOCAL_IOC_PATH=../qa_demo/local_ioc.txt
# Optional threat-intel keys (system works offline without them)
AEGIS_MB_AUTH_KEY=
AEGIS_VT_API_KEY=
AEGIS_DEMO_DRIVE_PATH=../qa_demo/sample_usb_drive
AEGIS_WATCH_USB=true
# Port for `python -m app`. If you change it, set VITE_BACKEND_PORT to match (frontend/.env)
AEGIS_PORT=8000
# Force offline intel (local IOC list only; no network lookups at all)
AEGIS_INTEL_OFFLINE=false
AEGIS_VT_DAILY_QUOTA=500
# The vault only supports aes-256-gcm; DES/3DES/RC4 are refused at startup
AEGIS_VAULT_CIPHER=aes-256-gcm
# Extra browser origins allowed to call the API (comma separated). Default: Vite on 5173 only
AEGIS_EXTRA_ORIGINS=
